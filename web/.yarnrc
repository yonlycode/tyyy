# Cache local au projet : le cache global yarn est en lecture seule dans
# l'environnement de build (CI/conteneurs), et le registre Forgejo interne
# présente un certificat émis par la CA interne Karuka (absente du magasin
# CA embarqué par Node) — yarn a sa propre config TLS, distincte de npm.
cache-folder ".yarn-cache"
strict-ssl false
