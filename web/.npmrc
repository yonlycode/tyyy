@karulab:registry=https://forgejo.intern.karuka-conseil.com/api/packages/karulab/npm/
# Forgejo interne : certificat émis par la CA interne Karuka, absente du
# magasin CA embarqué par Node. npm/yarn ont leur propre config TLS (le
# magasin système de curl ne suffit pas) — pattern fleet documenté.
strict-ssl=false
